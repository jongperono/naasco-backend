###############################################################################
# COMPLETE WORKFLOW EXAMPLE
###############################################################################

### Step 1: Register a new user
# @name registerUser
POST {{baseUrl}}/api/auth/register
Content-Type: {{contentType}}

{
  "email": "workflow@example.com",
  "password": "workflow123",
  "firstName": "Workflow",
  "lastName": "Test",
  "phoneNumber": "+1987654321"
}

### Step 2: Login with the registered user
# @name loginUser
POST {{baseUrl}}/api/auth/login
Content-Type: {{contentType}}

{
  "email": "workflow@example.com",
  "password": "workflow123"
}

### Step 3: Verify token (use token from Step 2)
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{loginUser.response.body.data.token}}

### Step 4: Get user profile (use token from Step 2)
GET {{baseUrl}}/api/users/profile
Authorization: Bearer {{loginUser.response.body.data.token}}

### Step 5: Create a new user (admin/manager only, use token from Step 2)
POST {{baseUrl}}/api/users
Authorization: Bearer {{loginUser.response.body.data.token}}
Content-Type: {{contentType}}

{
  "email": "created@example.com",
  "password": "created123",
  "firstName": "Created",
  "lastName": "User",
  "phoneNumber": "+1555666777"
}

### Step 6: Get all users (use token from Step 2)
GET {{baseUrl}}/api/users
Authorization: Bearer {{loginUser.response.body.data.token}}

###############################################################################
# NOTES
###############################################################################

# How to use:
# 1. Install "REST Client" extension in VS Code
# 2. Click "Send Request" above any request
# 3. After login/register, copy the token from response
# 4. Replace "YOUR_TOKEN_HERE" with the actual token
# 
# Or use the @name variables for chained requests:
# - Use {{registerUser.response.body.data.token}} to reference token from register
# - Use {{loginUser.response.body.data.token}} to reference token from login
#
# Expected Status Codes:
# - 200: Success (GET, most successful operations)
# - 201: Created (successful registration)
# - 400: Bad Request (validation errors)
# - 401: Unauthorized (invalid/missing token, wrong password)
# - 403: Forbidden (insufficient permissions)
# - 404: Not Found (user doesn't exist)
# - 409: Conflict (duplicate email)
# - 500: Internal Server Error
