# USER MANAGEMENT - PROFILE
###############################################################################

### Get user profile (requires authentication)
GET {{baseUrl}}/api/users/profile
Authorization: Bearer YOUR_TOKEN_HERE

### Get profile without token (should fail)
GET {{baseUrl}}/api/users/profile

###############################################################################
# USER MANAGEMENT - LIST USERS (Admin/Manager only)
###############################################################################

### Get all users (requires admin or manager role)
GET {{baseUrl}}/api/users
Authorization: Bearer YOUR_TOKEN_HERE

### Get all users without token (should fail)
GET {{baseUrl}}/api/users

###############################################################################
# USER MANAGEMENT - GET USER BY ID (Admin/Manager only)
###############################################################################

### Get user by ID (replace 1 with actual user ID)
GET {{baseUrl}}/api/users/1
Authorization: Bearer YOUR_TOKEN_HERE

### Get user by ID without token (should fail)
GET {{baseUrl}}/api/users/1

### Get user with invalid ID (should fail)
GET {{baseUrl}}/api/users/abc
Authorization: Bearer YOUR_TOKEN_HERE

### Get non-existent user (should fail with 404)
GET {{baseUrl}}/api/users/99999
Authorization: Bearer YOUR_TOKEN_HERE

