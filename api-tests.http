### NAASCO Backend API Tests
### Use the REST Client extension in VS Code to run these requests
### Click "Send Request" above each request or use Ctrl+Alt+R (Windows/Linux) or Cmd+Alt+R (Mac)

@baseUrl = http://localhost:3001
@contentType = application/json

# You can change these test credentials
@testEmail = jongperono@gmail.com
@testPassword = jongjong

# This will be set after login/register
@authToken = my-super-secret-jwt-key

###############################################################################
# PUBLIC ENDPOINTS
###############################################################################

### Health Check
GET {{baseUrl}}/api/health

### API Root
GET {{baseUrl}}/

###############################################################################
# AUTHENTICATION - REGISTER
###############################################################################

### Register a new user
POST {{baseUrl}}/api/auth/register
Content-Type: {{contentType}}

{
  "email": "jongperono@gmail.com",
  "password": "jongjong",
  "firstName": "Jong",
  "lastName": "Perono",
  "role": "admin",
  "phoneNumber": "+1234561234"
}

### Register without phone number (optional field)
POST {{baseUrl}}/api/auth/register
Content-Type: {{contentType}}

{
  "email": "user2@example.com",
  "password": "password123",
  "firstName": "John",
  "lastName": "Doe"
}

### Register with invalid email (should fail)
POST {{baseUrl}}/api/auth/register
Content-Type: {{contentType}}

{
  "email": "invalid-email",
  "password": "password123",
  "firstName": "Test",
  "lastName": "User"
}

### Register with short password (should fail)
POST {{baseUrl}}/api/auth/register
Content-Type: {{contentType}}

{
  "email": "test3@example.com",
  "password": "123",
  "firstName": "Test",
  "lastName": "User"
}

### Register duplicate email (should fail with 409)
POST {{baseUrl}}/api/auth/register
Content-Type: {{contentType}}

{
  "email": "{{testEmail}}",
  "password": "{{testPassword}}",
  "firstName": "Duplicate",
  "lastName": "User"
}

###############################################################################
# AUTHENTICATION - LOGIN
###############################################################################

### Login with valid credentials
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: {{contentType}}

{
  "email": "{{testEmail}}",
  "password": "{{testPassword}}"
}

### Login with wrong password (should fail)
POST {{baseUrl}}/api/auth/login
Content-Type: {{contentType}}

{
  "email": "{{testEmail}}",
  "password": "wrongpassword"
}

### Login with non-existent email (should fail)
POST {{baseUrl}}/api/auth/login
Content-Type: {{contentType}}

{
  "email": "nonexistent@example.com",
  "password": "password123"
}

### Login with invalid email format (should fail)
POST {{baseUrl}}/api/auth/login
Content-Type: {{contentType}}

{
  "email": "not-an-email",
  "password": "password123"
}

